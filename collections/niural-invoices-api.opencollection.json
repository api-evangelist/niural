{
  "opencollection": "1.0.0",
  "info": {
    "name": "Niural Public Invoices API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Invoices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of invoices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-sandbox.niural.com/invoices",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items to fetch. Default is 20"
              },
              {
                "name": "next_cursor",
                "value": "",
                "type": "query",
                "description": "Get the next set of items from the cursor provided in the previous response if any"
              },
              {
                "name": "contract_type",
                "value": "",
                "type": "query",
                "description": "Filter invoices by the type of contract"
              },
              {
                "name": "contract_id",
                "value": "",
                "type": "query",
                "description": "Filter invoices by the contract ID"
              },
              {
                "name": "invoice_status",
                "value": "",
                "type": "query",
                "description": "Filter invoices by their status"
              }
            ]
          },
          "docs": "Get a list of invoices"
        },
        {
          "info": {
            "name": "Create an invoice",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.niural.com/invoices",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an invoice"
        },
        {
          "info": {
            "name": "Get a single invoice",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-sandbox.niural.com/invoices/:invoice-id",
            "params": [
              {
                "name": "invoice-id",
                "value": "",
                "type": "path",
                "description": "The ID of the invoice to retrieve"
              }
            ]
          },
          "docs": "Get a single invoice"
        }
      ]
    }
  ],
  "bundled": true
}