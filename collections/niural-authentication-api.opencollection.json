{
  "opencollection": "1.0.0",
  "info": {
    "name": "Niural Public Authentication API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Obtain Auth token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.niural.com/authenticate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchange the client credentials (ID and secret) for an auth token. Use the auth token in the Authorization header for requests to other endpoints.\n"
        }
      ]
    }
  ],
  "bundled": true
}